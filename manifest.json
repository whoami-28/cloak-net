{
  "manifest_version": 3,
  "name": "CloakNet Stealth VPN",
  "version": "1.0.0",
  "description": "Персональное расширение маскировки сетевого трафика CloakNet для Chrome (SOCKS5 / WARP / Edge Proxy).",
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CloakNet VPN",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
